{
  "enabled": true,
  "name": "On architecture change",
  "description": "When an approved architecture file is saved, generate or update code, tests and trace links for the changed elements only, then check for drift.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "architecture/*.puml",
      "architecture/**/*.puml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "An approved architecture file under architecture/ changed. Read the changed file and work out which elements are new or whose block changed; leave unchanged elements alone.\n\nFor each changed element:\n1. Generate or update src/<element-id>.ts and test/<element-id>.test.ts.\n2. Run `node mcp/update-trace.mjs <element-id>` to record it. Never hand-write or edit a trace.json row: the hash must come from that script or drift reporting breaks.\n\nThen call the check_drift tool from the doppel-drift MCP server to verify your work, and fix anything it reports. Use the MCP tool, not the command-line script -- the tool is the supported interface and is already connected. Only if the tool is genuinely unavailable, fall back to `node mcp/check-drift.mjs` and say so explicitly."
  }
}
