{
  "enabled": true,
  "name": "On architecture change",
  "description": "When an architecture file is saved, update code, tests and trace links for the changed elements only.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["architecture/*.puml"] },
  "then": {
    "type": "askAgent",
    "prompt": "An architecture file changed. For each approved element whose block changed, generate or update one code file in src/ and one test file in test/, then update trace.json. Do not touch unchanged elements. Then call the check_drift tool and fix any drift it reports."
  }
}
